#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        def {
            display-name = "Base";
            bindings = <
&kp KP_MINUS      &kp KP_MULTIPLY  &kp KP_DIVIDE                      &kp ESCAPE      &kp NUMBER_1    &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7             &kp N8     &kp N9     &kp N0         &kp BACKSPACE
&kp KP_PLUS       &kp KP_NUMBER_9  &kp KP_NUMBER_8  &kp KP_NUMBER_7   &kp TAB         &kp Q           &kp W             &kp E         &kp R         &kp T     &kp Y         &kp U              &kp I      &kp O      &kp SEMICOLON  &kp DELETE
&lt 1 KP_NUMLOCK  &kp KP_NUMBER_6  &kp KP_NUMBER_5  &kp KP_NUMBER_4   &mo 2           &kp A           &kp S             &kp D         &kp F         &kp G     &kp H         &kp J              &kp K      &kp L      &kp P          &kp ENTER
&kp ENTER         &kp KP_NUMBER_3  &kp KP_NUMBER_2  &kp KP_NUMBER_1   &kp LEFT_SHIFT  &kp Z           &kp X             &kp C         &kp V         &kp B     &kp N         &kp M              &kp COMMA  &kp PERIOD &kp RSHIFT
                                                                      &kp KP_DOT      &kp KP_NUMBER_0 &kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE &kp RIGHT_ALT &kp RIGHT_CONTROL  &mo 2
            >;
        };

        nav {
            display-name = "Navigation";
            bindings = <
&kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp ESCAPE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7  &kp N8  &kp N9     &kp N0      &kp BACKSPACE
&trans        &kp PAGE_UP      &kp UP         &kp HOME    &kp TAB       &kp Q         &kp W         &kp E         &kp R   &kp T         &kp Y   &kp U   &kp I      &kp O       &kp SEMICOLON  &kp DELETE
&trans        &kp LEFT         &kp DOWN       &kp RIGHT   &trans        &kp A         &kp S         &kp D         &kp F   &kp G         &kp H   &kp J   &kp K      &kp L       &kp P          &kp SINGLE_QUOTE
&trans        &kp PAGE_DOWN    &kp INSERT     &kp END     &kp CAPSLOCK  &kp Z         &kp X         &kp C         &kp V   &kp B         &kp N   &kp M   &kp COMMA  &kp PERIOD  &trans
              &trans           &trans         &trans      &trans        &trans                                            &trans                                   &trans      &trans         &trans
            >;
        };

        sym {
            display-name = "Symbol";
            bindings = <
&kp F12  &kp F11  &kp F10  &kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR       &kp PERCENT   &kp CARET      &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&trans   &kp F9   &kp F8   &kp F7     &trans           &kp MINUS    &kp UNDERSCORE    &kp PLUS         &kp EQUAL     &kp PIPE       &kp QUESTION   &kp LEFT_BRACE    &kp RIGHT_BRACE       &kp LEFT_BRACKET       &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH
&trans   &kp F6   &kp F5   &kp F4     &trans           &kp TILDE    &none             &none            &kp QUESTION  &kp SEMICOLON  &kp COLON      &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES     &kp LESS_THAN          &kp GREATER_THAN   &kp SLASH
&trans   &kp F3   &kp F2   &kp F1     &caps_word       &kp C_MUTE   &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &kp C_VOL_DN  &none          &none          &none             &none                 &none                  &trans
         &trans   &trans   &trans     &trans           &trans                                                        &trans                                                                &trans                 &trans             &trans
            >;
        };

        sys {
            bindings = <
&none   &none  &none  &bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &none  &none  &none  &none  &none  &none
&none   &none  &none  &none       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &none         &none  &none  &none  &none  &none  &none  &none
&trans  &none  &none  &none       &trans           &none            &studio_unlock   &none            &none         &none  &none  &none  &none  &none  &none  &none
&none   &to 3  &to 2  &to 1       &none            &none            &none            &none            &none         &none  &none  &none  &none  &none  &none
        &none  &to 0  &none       &none            &none                                                            &none                       &none  &none  &trans
            >;

            label = "System control";
        };
    };
};
